EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key

# Google Gemini AI Vision API Key (Kept securely on backend, never exposed in client bundle)
GEMINI_API_KEY=your_google_gemini_api_key_here

# Backend Recognition Endpoint URL (Defaults to http://localhost:5001/api/recognize-diagram)
EXPO_PUBLIC_DIAGRAM_MATCH_URL=http://localhost:5001/api/recognize-diagram

# ─── Gemini Multi-Model Fallback Configuration ───
# Primary vision model (tried first). Must support image inputs.
# Recommended: gemini-3.8-flash (latest flash, vision-capable, recommended by Google)
GEMINI_PRIMARY_MODEL=gemini-3.8-flash

# Comma-separated ordered list of fallback models (tried in order if primary fails).
# All models must support vision/image inputs and JSON response format.
# These may share account-level quota — fallback helps with per-model rate limits and 503 overload.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-2.5-flash,gemini-2.5-pro

# Maximum retry attempts per model for transient errors (503, 500, 502, 504)
GEMINI_MAX_RETRIES=2

# Base delay (ms) for exponential backoff between retries
GEMINI_RETRY_BASE_DELAY_MS=1000

# Maximum delay cap (ms) for backoff
GEMINI_RETRY_MAX_DELAY_MS=10000

# Per-request timeout (ms) — abort if a single API call takes too long
GEMINI_REQUEST_TIMEOUT_MS=30000

# Total timeout (ms) — abort all fallback attempts if exceeded
GEMINI_TOTAL_TIMEOUT_MS=90000
