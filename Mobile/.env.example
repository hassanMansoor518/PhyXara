EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key

# Google Gemini AI Vision API Key (Kept securely on backend, never exposed in client bundle)
GEMINI_API_KEY=your_google_gemini_api_key_here

# Backend Recognition Endpoint URL (Defaults to http://localhost:5001/api/recognize-diagram)
EXPO_PUBLIC_DIAGRAM_MATCH_URL=http://localhost:5001/api/recognize-diagram
